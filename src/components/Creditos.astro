---
import { Image } from "astro:assets";

import fotoRaul from "../img/foto-raul.webp";
import fotoHernan from "../img/hernan.jpeg";
import fotoProfe1 from "../img/profe1.jpeg";
import fotoProfe2 from "../img/profe2.jpeg";

const { title } = Astro.props;
---

<div id="creditos"></div>

<div class="container mx-auto px-8 pt-20 pb-28">
  <h2 class="text-5xl font-bold text-center mb-15">
    {title}
  </h2>

  <div class="team">
    <div class="avatar">
      <div class="w-48 m-auto rounded-full">
        <Image src={fotoRaul} alt="foto Raul david villarreal" />
      </div>
      <p class="title">Raul David Villarreal</p>
      <p>Estudiante de Ingeniería Química</p>
    </div>
    <div class="avatar">
      <div class="w-48 m-auto rounded-full">
        <Image src={fotoProfe1} alt="Diana Paola Duarte" />
      </div>
      <p class="title">Diana Paola Duarte</p>
      <p>Doctora en Ingeniería Química</p>
    </div>
    <div class="avatar">
      <div class="w-48 m-auto rounded-full">
        <Image src={fotoHernan} alt="Hernan" class="img-hernan" />
      </div>
      <p class="title">Hernán Manrique</p>
      <p>Estudiante de Ingeniería Química</p>
    </div>
    <div class="avatar">
      <div class="w-48 m-auto rounded-full">
        <Image src={fotoProfe2} alt="Yuli Lopez" />
      </div>
      <p class="title">Yuli Fernanda Lopez</p>
      <p>Doctora en Ingeniería Química</p>
    </div>
  </div>
</div>

<style>
  .team {
    display: flex;
    justify-content: center;
    column-gap: 40px;
  }

  @media (max-width: 767px) {
    .team {
      flex-direction: column;
      align-items: center;
      row-gap: 40px;
    }
  }

  .avatar {
    display: flex;
    flex-direction: column;
  }

  .avatar .title {
    text-align: center;
    margin-top: 10px;
    font-size: 20px;
    font-weight: 600;
  }

  .img-hernan {
    object-position: 50% 30%;
  }
</style>